{
  "name": "ThingOrigin.js",
  "entryPoints": ["./src"],
  "entryPointStrategy": "expand",
  "excludeExternals": true,
  "excludeTags": ["@author", "@since"],
  "out": "./doc",
  "exclude": ["**/private/**", "**/workers/**", "node_modules/**"],
  "excludePrivate": true,
  "excludeProtected": false,
  "excludeInternal": false,
  "readme": "README.md",
  "hideGenerator": true,
  "disableSources": true,
  "categorizeByGroup": true,
  "categoryOrder": ["核心属性", "普通属性", "方法", "*"],
  "groupOrder": ["Interfaces", "Types", "Utils", "*"],
  "navigation": {
    "includeGroups": true,
    "includeCategories": false,
    "includeFolders": false
  },
  "customCss": "./doc-theme/threejs-like.css",
  "customJs": "./doc-theme/collapse-groups.js",
  "plugin": [
    "typedoc-plugin-merge-modules",
    "./doc-theme/typedoc-hide-constructors.mjs"
  ],
  "mergeModulesMergeMode": "module"
}
